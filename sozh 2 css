body { 
    font-family: 'Segoe UI', Arial, sans-serif; 
    line-height: 1.6; 
    margin: 20px; 
    background-color: #f4f7f6; 
    color: #be1818; 
}

header, section, footer { 
    background: #ed9bd0; 
    padding: 20px; 
    margin-bottom: 20px; 
    border-radius: 8px; 
    box-shadow: 0 2px 5px rgba(251, 46, 203, 0.1); 
}

h1, h2, h3 { 
    color: #2c3e50; 
}

table { 
    border-collapse: collapse; 
    width: 100%; 
    margin-top: 10px; 
}

th, td { 
    border: 1px solid #ddd; 
    padding: 10px; 
    text-align: left; 
}

th { 
    background-color: #e2dfe0; 
    color: #d4044d; 
}

#profile-img { 
    border-radius: 50%; 
    width: 150px; 
    height: 150px; 
    object-fit: cover; 
}

.skills-list { 
    list-style-type: square; 
}

section ul li { 
    margin-bottom: 8px; 
}

a { 
    color: #2980b9; 
    text-decoration: none; 
    font-weight: bold; 
}

a:hover { 
    text-decoration: underline; 
    color: #d4044d; 
}
