        #profile-img { border-radius: 50%; width: 150px; height: 150px; object-fit: cover; }

        .skills-list { list-style-type: square; }
        
        section ul li { margin-bottom: 8px; }
        
        a { color: #2980b9; text-decoration: none; font-weight: bold; }
        a:hover { text-decoration: underline; color: #d4044d; }
        
        p { color: #a818be; }
